{
  "manifest_version": 3,
  "name": "Schulassistenz-Helfer",
  "version": "0.6.0",
  "description": "Gibt Mails und Messenger-Nachrichten aus IServ (oder markierten Text von jeder Seite) mit Kürzeln statt Namen an Claude, setzt die Namen in der Antwort wieder ein und holt für die Startseite Stundenplan, Kalender und den Fehlzeiten-Export aus WebUntis. Die Kürzelliste bleibt auf diesem Rechner.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "alarms",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Schulassistenz-Helfer öffnen"
  },
  "options_page": "einstellungen.html",
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png",
    "16": "icon16.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/iserv/*",
        "http://*/iserv/*"
      ],
      "js": [
        "pseudo.js",
        "helfer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "file:///*Schulassistenz-Start.html"
      ],
      "js": [
        "startseite-bruecke.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/iserv/calendar*"
      ],
      "js": [
        "kalender-finder.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.webuntis.com/*",
    "https://*/iserv/*",
    "https://*/caldav/*",
    "https://*/webdav/*"
  ]
}
